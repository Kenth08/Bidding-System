generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                    String    @id @default(uuid()) @db.Uuid
  full_name                             String    @db.VarChar(255)
  email                                 String    @unique @db.VarChar(255)
  password_hash                         String    @map("password_hash") @db.VarChar(128)
  role                                  String    @default("supplier") @db.VarChar(20)
  status                                String    @default("waiting_admin_approval") @db.VarChar(30)
  company_name                          String    @default("") @db.VarChar(255)
  company_address                       String    @default("") @db.VarChar(255)
  phone                                 String    @default("") @db.VarChar(50)
  business_type                         String    @default("") @db.VarChar(100)
  representative_name                   String?   @db.VarChar(255)
  tin                                   String?   @db.VarChar(50)
  company_profile                       String?   @db.Text
  business_permit_document              String? // @deprecated use sec_dti_certificate and mayors_permit
  verification_status                   String    @default("waiting_admin_approval") @db.VarChar(30)
  session_version                       Int       @default(0)
  // New document fields
  sec_dti_certificate                   String?
  mayors_permit                         String?
  mayors_permit_expiry                  DateTime?
  tax_clearance_expiry                  DateTime?
  not_blacklisted_declaration           Boolean   @default(false)
  blacklisting_declaration_document     String?
  past_contracts_document               String?
  track_record_description              String?   @db.Text
  audited_financial_statements          String?
  financial_statement_year              Int?
  bank_reference_document               String?
  performance_certificates              String?
  representative_authorization_document String?

  // Existing fields
  philgeps_registration         String?
  philgeps_registration_expiry  DateTime?
  bir_form_2303                 String?
  valid_id_type                 String?
  valid_id_number               String?
  representative_job_title      String?
  iso_certificate_type          String?
  iso_certificate               String?
  iso_certificate_expiry        DateTime?
  bank_name                     String?
  bank_account_name             String?
  bank_account_number           String?
  tax_clearance                 String?
  valid_id                      String?
  supporting_documents          String?
  email_verified                Boolean                @default(false)
  email_verified_at             DateTime?
  email_verification_code_hash  String?
  email_verification_expires_at DateTime?
  email_verification_attempts   Int                    @default(0)
  email_verification_sent_at    DateTime?
  verified_at                   DateTime?
  verified_by_id                String?                @db.Uuid
  verification_notes            String?
  is_staff                      Boolean                @default(false)
  is_active                     Boolean                @default(true)
  is_superuser                  Boolean                @default(false)
  last_login                    DateTime?
  created_at                    DateTime               @default(now())
  updated_at                    DateTime               @updatedAt
  audit_logs                    AuditLog[]
  bids                          Bid[]
  blockchain_records            BlockchainRecord[]
  document_uploads              DocumentUpload[]
  notifications                 Notification[]
  procurements                  Procurement[]          @relation("CreatedProcurements")
  reviewed_procurements         Procurement[]          @relation("ReviewedProcurements")
  projects                      Project[]              @relation("CreatedProjects")
  supplier_business_types       SupplierBusinessType[]

  @@index([role, status])
  @@index([role, created_at])
  @@index([verification_status])
  @@map("users")
}

model Project {
  id                        String                @id @default(uuid()) @db.Uuid
  procurement_request_id    String?               @unique @db.Uuid
  title                     String                @db.VarChar(255)
  budget                    Decimal               @db.Decimal(15, 2)
  deadline                  DateTime              @db.Date
  procurement_schedule      DateTime?             @db.Date
  public_result_expiry_date DateTime?             @db.Date
  requirements              String                @default("")
  procurement_type          String                @default("Services") @db.VarChar(50)
  delivery_period           Int                   @default(0)
  technical_specifications  String                @default("")
  status                    String                @default("draft") @db.VarChar(20)
  is_archived               Boolean               @default(false)
  archived_at               DateTime?
  archived_reason           String?               @db.VarChar(255)
  published_at              DateTime?
  awarded_at                DateTime?
  open_to_all               Boolean               @default(true)
  created_by_id             String?               @db.Uuid
  created_at                DateTime              @default(now())
  updated_at                DateTime              @updatedAt
  bids                      Bid[]
  blockchain_records        BlockchainRecord[]
  created_by                User?                 @relation("CreatedProjects", fields: [created_by_id], references: [id])
  procurement_request       Procurement?          @relation(fields: [procurement_request_id], references: [id])
  project_business_types    ProjectBusinessType[]

  @@index([status, deadline])
  @@index([status, created_at])
  @@map("projects_project")
}

model Procurement {
  id                        String    @id @default(uuid()) @db.Uuid
  project_title             String    @db.VarChar(255)
  budget                    Decimal   @db.Decimal(15, 2)
  deadline                  DateTime? @db.Date
  public_result_expiry_date DateTime? @db.Date
  procurement_type          String    @db.VarChar(50)
  technical_specifications  String    @default("")
  procurement_schedule      String    @default("") @db.VarChar(255)
  delivery_period           String    @default("") @db.VarChar(255)
  status                    String    @default("Pending Review") @db.VarChar(30)
  rejection_reason          String    @default("")
  revision_notes            String    @default("")
  review_remarks            String?
  reviewed_by_id            String?   @db.Uuid
  reviewed_at               DateTime?
  created_by_id             String?   @db.Uuid
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  created_by                User?     @relation("CreatedProcurements", fields: [created_by_id], references: [id])
  reviewed_by               User?     @relation("ReviewedProcurements", fields: [reviewed_by_id], references: [id])
  project                   Project?

  @@map("procurements")
}

model Bid {
  id                          String             @id @default(uuid()) @db.Uuid
  project_id                  String             @db.Uuid
  supplier_id                 String             @db.Uuid
  company_name                String             @default("") @db.VarChar(255)
  bid_amount                  Decimal            @db.Decimal(12, 2)
  proposal                    String             @default("")
  quotation_file              String?
  technical_proposal          String?
  supporting_documents        String?
  quotation_document          String?
  no_conflict_of_interest     Boolean            @default(false)
  conflict_of_interest_person String?
  no_past_scm_issues          Boolean            @default(false)
  past_scm_issues_details     String?
  signed_bid_form             String?
  digital_signature           String?
  signature_name              String?
  signature_signed_at         DateTime?
  technical_document          String?
  status                      String             @default("submitted") @db.VarChar(50)
  technical_compliance        Boolean?           @default(false)
  evaluation_remarks          String             @default("")
  rank                        Int?
  recorded                    Boolean            @default(false)
  submitted_at                DateTime           @default(now())
  updated_at                  DateTime           @updatedAt
  project                     Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  supplier                    User               @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  blockchain_records          BlockchainRecord[]

  @@unique([project_id, supplier_id])
  @@index([supplier_id, submitted_at])
  @@index([project_id, status])
  @@map("bids_bid")
}

model BlockchainRecord {
  id             String   @id @default(uuid()) @db.Uuid
  project_id     String   @db.Uuid
  bid_id         String   @db.Uuid
  winner_id      String   @db.Uuid
  bid_amount     Decimal  @db.Decimal(15, 2)
  hash           String   @unique
  project_ref_id String?
  recorded_at    DateTime @default(now())
  bid            Bid      @relation(fields: [bid_id], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  winner         User     @relation(fields: [winner_id], references: [id], onDelete: Cascade)

  @@map("blockchain_blockchainrecord")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  action        String   @db.VarChar(50)
  user_id       String?  @db.Uuid
  description   String   @default("")
  resource_type String   @default("") @db.VarChar(100)
  resource_id   String   @default("") @db.VarChar(255)
  created_at    DateTime @default(now())
  user          User?    @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at])
  @@index([resource_type, resource_id])
  @@map("audit_logs")
}

model DocumentUpload {
  id                  String    @id @default(uuid()) @db.Uuid
  user_id             String    @db.Uuid
  document_type       String    @db.VarChar(50)
  file_name           String    @db.VarChar(255)
  file                String?
  file_size           Int       @default(0)
  verification_status String    @default("pending_review") @db.VarChar(30)
  verification_notes  String?
  verified_by_id      String?   @db.Uuid
  verified_at         DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, document_type])
  @@map("document_uploads")
}

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  recipient_id  String   @db.Uuid
  type          String   @db.VarChar(50)
  title         String   @db.VarChar(255)
  message       String
  is_read       Boolean  @default(false)
  link          String?  @db.VarChar(255)
  related_id    String?  @db.VarChar(64)
  resource_type String?  @db.VarChar(50)
  resource_id   String?  @db.Uuid
  created_at    DateTime @default(now())
  recipient     User     @relation(fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([recipient_id, is_read, created_at])
  @@map("notifications")
}

model BusinessType {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String                 @unique @db.VarChar(255)
  description String?                @db.Text
  is_active   Boolean                @default(true)
  created_at  DateTime               @default(now())
  updated_at  DateTime               @updatedAt
  suppliers   SupplierBusinessType[]
  projects    ProjectBusinessType[]

  @@map("business_types")
}

model SupplierBusinessType {
  supplier_id      String   @db.Uuid
  business_type_id String   @db.Uuid
  created_at       DateTime @default(now())

  supplier      User         @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  business_type BusinessType @relation(fields: [business_type_id], references: [id], onDelete: Cascade)

  @@unique([supplier_id, business_type_id])
  @@map("supplier_business_types")
}

model ProjectBusinessType {
  project_id       String   @db.Uuid
  business_type_id String   @db.Uuid
  created_at       DateTime @default(now())

  project       Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  business_type BusinessType @relation(fields: [business_type_id], references: [id], onDelete: Cascade)

  @@unique([project_id, business_type_id])
  @@map("project_business_types")
}

model BidActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  project_id  String   @db.Uuid
  bid_id      String?  @db.Uuid
  supplier_id String?  @db.Uuid
  user_id     String?  @db.Uuid
  role        String   @default("system") @db.VarChar(30)
  action      String   @db.VarChar(100)
  description String   @default("")
  created_at  DateTime @default(now())

  @@index([project_id])
  @@index([supplier_id])
  @@map("bid_activity_logs")
}
